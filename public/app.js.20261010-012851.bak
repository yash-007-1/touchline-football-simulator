const socket=io();
const $=s=>document.querySelector(s);
let state=null, myTeamId=null, roomCode=null, isHost=false, activeTab="overview", tick=null;
const money=n=>`€${Math.round(n)}M`;
function notice(message,type="error"){const n=$("#notice");n.textContent=message;n.className="notice "+(type==="success"?"success":"");setTimeout(()=>n.classList.add("hidden"),4500);}
socket.on("connect",()=>$("#connection").textContent="CONNECTED");
socket.on("disconnect",()=>$("#connection").textContent="RECONNECTING");
socket.on("notice",n=>notice(n.message,n.type));
socket.on("joined",d=>{myTeamId=d.teamId;roomCode=d.code;isHost=d.isHost;$("#game").classList.remove("hidden");document.querySelector(".hero").classList.add("hidden");$("#roomCodeDisplay").textContent=roomCode;$("#roomTitle").textContent=`Room ${roomCode}`;notice("You joined the room. Share the code with your friends.","success");});
socket.on("state",s=>{state=s; if(!myTeamId){const mine=s.teams.find(t=>t.socketId===socket.id);if(mine)myTeamId=mine.id;} $("#roomCodeDisplay").textContent=s.code;$("#phaseLabel").textContent=({lobby:"ROOM LOBBY",auction:"LIVE PLAYER AUCTION",reveal:"SQUAD REVEAL",league:"LEAGUE IN PROGRESS",complete:"SEASON COMPLETE"})[s.phase]||s.phase;$("#roomSub").textContent=({lobby:"Waiting for managers to join.",auction:"The bidding is live. Make every million count.",reveal:"The squads are assembled. Time to prepare.",league:`Matchday ${s.matchday} — set your XI and get ready.`,complete:"The final whistle has blown."})[s.phase]||"";render();});
function populate(select){select.innerHTML="";(state?.clubList||window.clubCache||[]).forEach(c=>{const o=document.createElement("option");o.value=c.name;o.textContent=`${c.name} · ${c.league}`;select.appendChild(o);});}
socket.on("connect",()=>{fetch("/api/health").then(r=>r.json()).then(()=>{});});
fetch("/api/health").then(()=>fetch("/api/clubs")).catch(()=>{});
/* Club list is bundled here to allow the entry forms to render immediately. */
window.clubCache=[["Arsenal","Premier League"],["Liverpool","Premier League"],["Manchester City","Premier League"],["Chelsea","Premier League"],["Manchester United","Premier League"],["Tottenham Hotspur","Premier League"],["Real Madrid","La Liga"],["Barcelona","La Liga"],["Atlético Madrid","La Liga"],["Athletic Club","La Liga"],["Bayern Munich","Bundesliga"],["Borussia Dortmund","Bundesliga"],["Bayer Leverkusen","Bundesliga"],["Inter","Serie A"],["AC Milan","Serie A"],["Juventus","Serie A"],["Napoli","Serie A"],["Paris Saint-Germain","Ligue 1"],["Marseille","Ligue 1"],["Monaco","Ligue 1"]].map(([name,league])=>({name,league}));
populate($("#createClub"));populate($("#joinClub"));
$("#createForm").onsubmit=e=>{e.preventDefault();socket.emit("createRoom",{name:$("#createName").value,club:$("#createClub").value});};
$("#joinForm").onsubmit=e=>{e.preventDefault();socket.emit("joinRoom",{code:$("#roomCode").value.trim().toUpperCase(),name:$("#joinName").value,club:$("#joinClub").value});};
$("#copyCode").onclick=()=>navigator.clipboard?.writeText(roomCode).then(()=>notice("Room code copied.","success"));
$("#tabs").onclick=e=>{const b=e.target.closest("button[data-tab]");if(!b)return;activeTab=b.dataset.tab;document.querySelectorAll(".tabs button").forEach(x=>x.classList.toggle("active",x===b));render();};
function myTeam(){return state?.teams.find(t=>t.id===myTeamId);}
function btn(text,action,cls="soft-btn",disabled=false){return `<button class="${cls}" data-action="${action}" ${disabled?"disabled":""}>${text}</button>`;}
function render(){if(!state)return;const view=$("#view");let html="";switch(activeTab){case"overview":html=overview();break;case"auction":html=auction();break;case"squads":html=squads();break;case"schedule":html=schedule();break;case"tactics":html=tactics();break;case"table":html=table();break;}view.innerHTML=html;view.querySelectorAll("[data-action]").forEach(b=>b.onclick=()=>action(b.dataset.action));view.querySelectorAll("[data-lineup]").forEach(x=>x.onchange=()=>saveLineup());view.querySelectorAll("[data-tactic]").forEach(x=>x.onchange=()=>saveLineup());if(activeTab==="auction"&&state.phase==="auction"){clearInterval(tick);tick=setInterval(()=>{const t=$("#timer");if(t){const sec=Math.max(0,Math.ceil((state.auction.endsAt-Date.now())/1000));t.textContent=`00:${String(sec).padStart(2,"0")}`;}},250);}}
function overview(){const mine=myTeam();return `${state.phase==="complete"?`<div class="result-banner"><h2>🏆 ${esc(state.champion||"Champion")} — League Champions</h2><p>The season is complete. Review the final standings and match results.</p></div>`:""}<div class="section-head"><div><h2>Manager room</h2><div class="muted">${state.teams.length}/10 managers · ${state.phase==="lobby"?"Waiting for players":state.phase==="auction"?"Auction live":state.phase==="reveal"?"Auction completed":state.phase==="league"?"Season underway":"Season finished"}</div></div>${state.phase==="lobby"&&isHost?btn("Start auction →","startAuction","green-btn",state.teams.length<2):state.phase==="reveal"&&isHost?btn("Start league →","startLeague","green-btn"):state.phase==="league"&&isHost?btn(`Simulate matchday ${state.matchday} →`,"simulate","green-btn"):state.phase==="complete"?btn("View final table →","gotoTable","green-btn"):""}</div><div class="grid">${state.teams.map(t=>`<div class="team-card"><div class="team-top"><div class="crest">${esc(t.club.slice(0,1))}</div><div><h3>${esc(t.club)} ${t.isHost?"♛":""}</h3><p>${esc(t.manager)} ${t.id===myTeamId?"· YOU":""}</p></div></div><div class="statline"><span>Squad <strong>${t.squad.length}</strong></span><span>Budget <strong>${money(t.budget)}</strong></span></div><div class="statline"><span>${esc(t.league)}</span><span>${t.connected===false?"Offline":"Joined"}</span></div></div>`).join("")}</div><div class="section-head"><div><h2>Your club dashboard</h2><div class="muted">${mine?esc(mine.club):""}</div></div></div><div class="grid"><div class="card"><div class="eyebrow">TRANSFER BUDGET</div><h2>${money(mine?.budget??1000)}</h2><p class="muted">Starting budget €1,000M</p></div><div class="card"><div class="eyebrow">SQUAD SIZE</div><h2>${mine?.squad.length??0} <span class="muted">/ 25</span></h2><p class="muted">Build a balanced matchday squad.</p></div><div class="card"><div class="eyebrow">SEASON</div><h2>${state.phase==="complete"?"FULL TIME":state.phase==="league"?`MATCHDAY ${state.matchday}`:state.phase.toUpperCase()}</h2><p class="muted">${state.schedule.length} scheduled fixtures</p></div></div>${state.lastResults?.length?`<div class="section-head"><h2>Latest results</h2></div><div class="fixture-list">${state.lastResults.map(resultCard).join("")}</div>`:""}`}
function auction(){if(state.phase!=="auction")return `<div class="empty"><h2>${state.phase==="lobby"?"Auction has not started":state.phase==="reveal"?"Auction complete":"No live auction"}</h2><p>Use Overview to start or continue the game.</p></div>`;const p=state.auction.currentPlayer;if(!p)return `<div class="empty">Preparing next player…</div>`;const mine=myTeam();return `<div class="auction-layout"><div class="player-hero"><div class="eyebrow">NOW UP FOR AUCTION · ${state.auction.index}/${state.auction.total}</div><div class="player-rating">${p.rating}</div><h2>${esc(p.name)}</h2><div class="player-meta">${esc(p.pos)} · ${esc(p.nation)} · ${p.age} years · ${esc(p.club)}</div><div class="price-row"><div><span class="muted">CURRENT BID</span><strong>${money(state.auction.highestBid||p.price)}</strong><small class="muted">${state.auction.highestBidder?`Highest bidder: ${esc(state.teams.find(t=>t.id===state.auction.highestBidder)?.manager||"Manager")}`:"Starting price"}</small></div><div style="text-align:right"><span class="muted">TIME LEFT</span><div class="timer" id="timer">00:15</div></div></div><div class="bid-row"><input id="bidAmount" type="number" min="${Math.max(p.price,state.auction.highestBid+1)}" max="${mine?.budget||0}" step="1" value="${Math.min(mine?.budget||p.price,Math.max(p.price,state.auction.highestBid+1))}"><button class="green-btn" data-action="bid" ${!mine||mine.budget<Math.max(p.price,state.auction.highestBid+1)||state.auction.highestBidder===myTeamId?"disabled":""}>PLACE BID ↗</button></div><p class="muted">Minimum bid ${money(Math.max(p.price,state.auction.highestBid+1))} · Your budget ${money(mine?.budget||0)}</p></div><div class="card"><div class="section-head"><h2>Managers & budgets</h2></div>${state.teams.map(t=>`<div class="log-item"><span>${esc(t.club)}<small class="muted"> · ${esc(t.manager)}</small></span><strong>${money(t.budget)}</strong></div>`).join("")}<div class="section-head"><h2>Recent sales</h2></div><div class="log-list">${[...(state.auction.log||[])].reverse().map(l=>`<div class="log-item"><span>${esc(l.player)}<small class="muted"> · ${esc(l.manager)}</small></span><strong>${l.bid?money(l.bid):"UNSOLD"}</strong></div>`).join("")||`<p class="muted">No sales yet.</p>`}</div>${isHost?btn("End auction early","finishAuction","soft-btn"):""}</div></div>`}
function squads(){return `<div class="section-head"><div><h2>Squad room</h2><div class="muted">All auction results, budgets and purchased players.</div></div></div><div class="squad-columns">${state.teams.map(t=>`<div class="card"><div class="team-top"><div class="crest">${esc(t.club[0])}</div><div><h3>${esc(t.club)}</h3><p class="muted">${esc(t.manager)} · ${t.squad.length} players</p></div></div><div class="statline"><span>Spent <strong>${money(1000-t.budget)}</strong></span><span>Left <strong>${money(t.budget)}</strong></span></div>${t.squad.length?t.squad.slice().sort((a,b)=>b.rating-a.rating).map(p=>`<div class="player-row"><div class="rating-chip">${p.rating}</div><div class="grow"><strong>${esc(p.name)}</strong><small>${esc(p.pos)} · ${esc(p.nation)} · ${money(p.paid||p.price)}</small></div></div>`).join(""):`<p class="muted">No players purchased yet.</p>`}</div>`).join("")}</div>${state.phase==="reveal"&&isHost?`<div class="action-row">${btn("Review schedule","schedule","soft-btn")}${btn("Start league →","startLeague","green-btn")}</div>`:""}`}
function schedule(){if(!state.schedule.length)return `<div class="empty"><h2>Schedule not generated yet</h2><p>The host starts the league after the auction. The full fixture list will then be saved here.</p>${state.phase==="reveal"&&isHost?btn("Generate schedule & start league","startLeague","green-btn"):""}</div>`;const rounds=[...new Set(state.schedule.map(f=>f.round))].sort((a,b)=>a-b);return `<div class="section-head"><div><h2>Season fixtures</h2><div class="muted">${state.schedule.length} total fixtures · double round-robin</div></div><span class="tag">${state.phase==="complete"?"COMPLETED":`MATCHDAY ${state.matchday}`}</span></div>${rounds.map(r=>`<div class="section-head"><h2>Matchday ${r}</h2><span class="muted">${state.schedule.filter(f=>f.round===r&&f.status==="played").length}/${state.schedule.filter(f=>f.round===r).length} played</span></div><div class="fixture-list">${state.schedule.filter(f=>f.round===r).map(f=>{const h=state.teams.find(t=>t.id===f.home),a=state.teams.find(t=>t.id===f.away);return `<div class="fixture"><div>${esc(h?.club||"TBC")}<small class="muted" style="display:block">${esc(h?.manager||"")}</small></div><div class="score">${f.status==="played"?`${f.result.homeGoals} : ${f.result.awayGoals}`:"VS"}</div><div class="away">${esc(a?.club||"TBC")}<small class="muted" style="display:block">${esc(a?.manager||"")}</small></div></div>`}).join("")}</div>`).join("")}`}
function tactics(){const t=myTeam();if(!t)return `<div class="empty">Join a room to manage a squad.</div>`;if(!["league","complete"].includes(state.phase))return `<div class="empty"><h2>Lineup room unlocks after the league starts</h2><p>Once the auction ends, start the league to set your XI and tactics.</p></div>`;const formation=t.formation||"4-3-3",positions=state.formations[formation]||state.formations["4-3-3"];const selected=t.lineup||[];return `<div class="section-head"><div><h2>Team setup</h2><div class="muted">${esc(t.club)} · Select exactly 11 players and save your strategy.</div></div>${btn("Save XI & tactics","saveLineup","green-btn")}</div><div class="squad-columns"><div><div class="form-grid"><label>Formation<select id="formation" data-tactic><option ${formation==="4-3-3"?"selected":""}>4-3-3</option><option ${formation==="4-4-2"?"selected":""}>4-4-2</option><option ${formation==="4-2-3-1"?"selected":""}>4-2-3-1</option><option ${formation==="3-5-2"?"selected":""}>3-5-2</option><option ${formation==="3-4-3"?"selected":""}>3-4-3</option><option ${formation==="4-1-4-1"?"selected":""}>4-1-4-1</option><option ${formation==="5-3-2"?"selected":""}>5-3-2</option></select></label><label>Mentality<select id="mentality" data-tactic>${["Very Defensive","Defensive","Balanced","Attacking","Very Attacking"].map(x=>`<option ${t.tactics?.mentality===x?"selected":""}>${x}</option>`).join("")}</select></label><label>Pressing<select id="pressing" data-tactic>${["Low","Medium","High"].map(x=>`<option ${t.tactics?.pressing===x?"selected":""}>${x}</option>`).join("")}</select></label><label>Build-up<select id="build" data-tactic>${["Short Passing","Balanced","Direct"].map(x=>`<option ${t.tactics?.build===x?"selected":""}>${x}</option>`).join("")}</select></label></div><div class="section-head"><h2>Available players</h2><span class="muted">${selected.length}/11 selected</span></div>${t.squad.map(p=>`<label class="player-row" style="cursor:pointer"><input style="width:auto;margin:0" type="checkbox" data-lineup value="${p.id}" ${selected.includes(p.id)?"checked":""} ${!selected.includes(p.id)&&selected.length>=11?"disabled":""}><div class="rating-chip">${p.rating}</div><div class="grow"><strong>${esc(p.name)}</strong><small>${esc(p.pos)} · ${esc(p.nation)}</small></div></label>`).join("")||`<p class="muted">Your squad is empty. You need to acquire players in the auction.</p>`}</div><div><div class="section-head"><h2>Formation preview</h2></div><div class="pitch">${positions.reduce((arr,pos,i)=>{const row=i===0?0:Math.min(3,Math.floor((i-1)/4)+1);(arr[row]||(arr[row]=[])).push({pos,i});return arr;},[]).map(row=>`<div class="pitch-line">${row.map(({pos,i})=>{const p=t.squad.find(p=>p.id===selected[i]);return `<div class="pitch-player">${p?esc(p.name.split(" ").slice(-1)[0]):pos}<small>${pos}</small></div>`}).join("")}</div>`).join("")}</div><div class="card" style="margin-top:15px"><div class="eyebrow">MATCH ENGINE</div><p class="muted">Your XI's average rating, defensive balance, attacking quality, mentality, pressing, and build-up style affect the simulated match outcome.</p></div></div></div>`}
function table(){const rows=state.standings||[];return `<div class="section-head"><div><h2>${state.phase==="complete"?"Final standings":"League table"}</h2><div class="muted">3 points for a win · 1 for a draw · sorted by points, goal difference, goals scored.</div></div></div><div class="table-wrap"><table><thead><tr><th>#</th><th>Club</th><th>MP</th><th>W</th><th>D</th><th>L</th><th>GF</th><th>GA</th><th>GD</th><th>Pts</th></tr></thead><tbody>${rows.map((r,i)=>`<tr><td>${i===0&&state.phase==="complete"?"🏆":i+1}</td><td><strong>${esc(r.name)}</strong><small class="muted" style="display:block">${esc(r.manager)}</small></td><td>${r.played}</td><td>${r.w}</td><td>${r.d}</td><td>${r.l}</td><td>${r.gf}</td><td>${r.ga}</td><td>${r.gd>0?"+":""}${r.gd}</td><td><strong>${r.pts}</strong></td></tr>`).join("")}</tbody></table></div>${state.phase==="league"&&isHost?`<div class="action-row">${btn(`Simulate matchday ${state.matchday} →`,"simulate","green-btn")}</div>`:""}${state.lastResults?.length?`<div class="section-head"><h2>Last matchday</h2></div><div class="fixture-list">${state.lastResults.map(resultCard).join("")}</div>`:""}`}
function resultCard(r){return `<div class="fixture"><div>${esc(r.home||state.teams.find(t=>t.id===r.fixture.home)?.club||"Home")}</div><div class="score">${r.result.homeGoals} : ${r.result.awayGoals}</div><div class="away">${esc(r.away||state.teams.find(t=>t.id===r.fixture.away)?.club||"Away")}</div><div style="grid-column:1/-1;border-top:1px solid var(--line);padding-top:9px;color:var(--muted);font-size:11px">${(r.result.events||[]).map(e=>`${e.minute}' ${esc(e.scorer)}`).join(" · ")||"No goals"}<br>Shots ${r.result.shotsHome}–${r.result.shotsAway} · Possession ${r.result.possessionHome}%–${100-r.result.possessionHome}%</div></div>`}
function action(a){if(a==="startAuction")socket.emit("startAuction");if(a==="finishAuction")socket.emit("finishAuction");if(a==="startLeague")socket.emit("startLeague");if(a==="simulate")socket.emit("simulateMatchday");if(a==="bid"){const amount=Number($("#bidAmount")?.value);socket.emit("bid",{amount});}if(a==="gotoTable"){activeTab="table";document.querySelectorAll(".tabs button").forEach(x=>x.classList.toggle("active",x.dataset.tab==="table"));render();}if(a==="schedule"){activeTab="schedule";document.querySelectorAll(".tabs button").forEach(x=>x.classList.toggle("active",x.dataset.tab==="schedule"));render();}if(a==="saveLineup")saveLineup();}
function saveLineup(){const t=myTeam();if(!t)return;const formation=$("#formation")?.value||t.formation;const lineup=[...document.querySelectorAll("[data-lineup]:checked")].map(x=>x.value);socket.emit("saveLineup",{formation,lineup,mentality:$("#mentality")?.value||"Balanced",pressing:$("#pressing")?.value||"Medium",build:$("#build")?.value||"Balanced"});}
function esc(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
